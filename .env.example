# ==============================================================================
# Aali AI — Environment Configuration Template
# Disaster Resilience Decision-Support System for Feni Flash Floods
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` with real secrets!

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. LOCAL DATABASE (MySQL 8.4)
# ------------------------------------------------------------------------------
# Local standard / XAMPP / Native MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=aali_ai
MYSQL_USER=aali_dev
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

# Docker Compose database configuration & published host ports
AALI_DB_NAME=aali_ai
AALI_DB_USER=aali_dev
AALI_DB_PASSWORD=aali-local-dev-password
AALI_DB_ROOT_PASSWORD=aali-local-root-password
MYSQL_PUBLISHED_PORT=3307
AALI_API_PORT=3002
AALI_WEB_PORT=5174

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC HASHING
# ------------------------------------------------------------------------------
# JWT signing secret (Must be at least 16 characters; production enforces non-default)
JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_EXPIRES_IN=24h

# HMAC salt for NID anonymization (Must be at least 32 characters)
NID_HASH_SECRET=replace-with-a-long-random-local-nid-hash-secret

# ------------------------------------------------------------------------------
# 4. AI & NLP SERVICES (Google Gemini Flash & Deterministic Fallback)
# ------------------------------------------------------------------------------
# Provider mode: 'remote' (live Gemini API) | 'mock' | 'local' (deterministic local)
AI_PROVIDER=remote
AI_PRIMARY_PROVIDER=gemini_flash
AI_BACKUP_PROVIDER=deterministic_fallback
AI_TIMEOUT_MS=4000
AI_BASE_URL=

# Paste your Google Gemini API Key below for real-time dialect extraction & drafting
AI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. TELECOM & SMPP v3.4 INGESTION GATEWAY (ACT-08)
# ------------------------------------------------------------------------------
# TCP port for incoming mobile operator SMSC bindings (1090 / 999 shortcodes)
SMPP_PORT=2775
HTTP_ADMIN_PORT=2776
EMERGENCY_SHORTCODE=1090
SMPP_SYSTEM_ID=aali_gateway
SMPP_PASSWORD=feni_flood_2024
SMPP_API_ENDPOINT=http://127.0.0.1:3001/api/v1/gateway/sms

# ------------------------------------------------------------------------------
# 6. WEB DASHBOARD (Vite + React)
# ------------------------------------------------------------------------------
# Optional backend API override for Vite frontend (defaults to same-origin / proxy)
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 7. FLUTTER MOBILE APP CLIENT (apps/mobile)
# ------------------------------------------------------------------------------
# Backend URL used when compiling Flutter with --dart-define=AALI_API_URL=...
# Android Emulator: http://10.0.2.2:3001 | Localhost/Chrome: http://127.0.0.1:3001 | Physical: http://<LAN_IP>:3001
AALI_API_URL=http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 8. RESILIENCE RULES & HARDWARE SIMULATION FLAGS
# ------------------------------------------------------------------------------
# Safe defaults: deterministic local providers and clearly labelled simulations
SMS_GATEWAY_MODE=simulated
SATELLITE_MODE=simulated
OFFICIAL_DATA_MODE=fixtures
DEMO_DATA_ONLY=true

# Starlink Direct-to-Cell (D2C) Hardware Simulation:
# In hackathon premise where real satellite payload is unavailable, Wi-Fi uplink
# is intentionally treated as Starlink D2C satellite connectivity.
STARLINK_D2C_SIMULATION=true

# Official external feeds & sensor telemetry
BMD_CAP_RSS_URL=https://cap.bmd.gov.bd/api/cap/rss.xml

# Deterministic threshold windows (minutes & meters)
ROAD_WATER_FRESHNESS_MINUTES=90
SILENT_VILLAGE_MINUTES=20
GAUGE_SILENCE_MINUTES=60
DUPLICATE_WINDOW_MINUTES=30
DUPLICATE_RADIUS_METERS=300

# Optional GPT reviewer. Keep the actual key only in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BRAIN_AUTORUN_ENABLED=true
