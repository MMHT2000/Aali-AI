# Copy to .env for local development. Do not commit .env.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aali_ai
MYSQL_USER=root
MYSQL_PASSWORD=

# Docker Compose database credentials and host ports (kept separate from XAMPP settings above).
AALI_DB_NAME=aali_ai
AALI_DB_USER=aali_dev
AALI_DB_PASSWORD=aali-local-dev-password
AALI_DB_ROOT_PASSWORD=aali-local-root-password
MYSQL_PUBLISHED_PORT=3307
AALI_API_PORT=3002
AALI_WEB_PORT=5174

JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_EXPIRES_IN=30m
NID_HASH_SECRET=replace-with-a-long-random-local-nid-hash-secret

# Safe defaults: deterministic local providers and clearly labelled simulation.
AI_PROVIDER=mock
AI_PRIMARY_PROVIDER=deterministic_mock
AI_BACKUP_PROVIDER=deterministic_fallback
AI_TIMEOUT_MS=3000
AI_BASE_URL=
AI_API_KEY=
SMS_GATEWAY_MODE=simulated
SATELLITE_MODE=simulated
OFFICIAL_DATA_MODE=fixtures
DEMO_DATA_ONLY=true
BMD_CAP_RSS_URL=https://cap.bmd.gov.bd/api/cap/rss.xml

# Prototype defaults; expose these values in the configuration/decision documentation.
ROAD_WATER_FRESHNESS_MINUTES=90
SILENT_VILLAGE_MINUTES=20
GAUGE_SILENCE_MINUTES=60
DUPLICATE_WINDOW_MINUTES=30
DUPLICATE_RADIUS_METERS=300
